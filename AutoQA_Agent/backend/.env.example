APP_NAME=AutoQA Agent
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/autoqa_agent
WORKSPACE_DIR=../repositories
REPORTS_DIR=../reports
LOG_LEVEL=INFO
# ── Cloud LLM & Embedding Settings (Groq Multi-Key Setup) ─────────────────────
# Single Groq API Key:
GROQ_API_KEY=gsk_your_groq_api_key_here

# Multiple Groq API Keys (Comma-separated for round-robin rotation & rate-limit failover):
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Task-Dedicated Groq API Keys (Isolate rate limits per workflow task):
GROQ_API_KEY_CODE=gsk_key_dedicated_for_code_analysis
GROQ_API_KEY_TEXT=gsk_key_dedicated_for_readme_and_modules
GROQ_API_KEY_REPORT=gsk_key_dedicated_for_architecture_reports
GROQ_API_KEY_CHAT=gsk_key_dedicated_for_interactive_chat

# Cloud Provider (Default: groq)
CLOUD_LLM_PROVIDER=groq
CLOUD_EMBED_PROVIDER=local  # Uses in-memory feature vectors (zero OpenAI/Gemini required)

# Groq Model Names
CLOUD_TEXT_MODEL=llama-3.3-70b-versatile
CLOUD_CODE_MODEL=llama-3.3-70b-versatile

# Concurrency and Timeouts
CLOUD_MAX_CONCURRENCY=5
CLOUD_CHUNK_TIMEOUT_SECONDS=30

# ── File analysis budget ──────────────────────────────────────────────────────
# Hard cap on files sent to the code analysis stage per repository
MAX_FILES_TO_ANALYZE=40
# Approximate token budget for code analysis (4 chars ≈ 1 token heuristic)
MAX_CODE_TOKEN_BUDGET=60000
# Max characters per semantic code chunk submitted to the code model
CODE_CHUNK_MAX_CHARS=3000

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Required for the "Email Report" button in the frontend.
#
# Setup:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password:   https://myaccount.google.com/apppasswords
#      (App = Mail, Device = Other → name it "AutoQA")
#   3. Paste the 16-character App Password below (spaces optional).
#
# ⚠ Your regular Gmail password will NOT work here — App Passwords only.
EMAIL_SENDER_ADDRESS=your-gmail-address@gmail.com
EMAIL_SENDER_APP_PASSWORD=   # 16-char App Password from myaccount.google.com/apppasswords